NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=
COHERE_API_KEY=

# Multimodal provider (OpenAI-compatible vision endpoint)
OPENAI_API_KEY=
MULTIMODAL_BASE_URL=https://api.openai.com/v1
MULTIMODAL_VISION_MODEL=gpt-4.1-mini
MULTIMODAL_TIMEOUT=90
MULTIMODAL_MAX_UPLOAD_BYTES=12582912
MULTIMODAL_MAX_IMAGE_PIXELS=40000000
MULTIMODAL_MAX_VISION_DIMENSION=2048

# Grounded generation (Cohere)
COHERE_MULTIMODAL_RAG_MODEL=command-a-03-2025
COHERE_MULTIMODAL_FALLBACK_MODEL=command-r7b-12-2024

# Biomedical retrieval (NCBI PubMed E-utilities)
PUBMED_TIMEOUT=15
PUBMED_TOOL=RAGnosis
# Optional NCBI etiquette / higher rate limit:
PUBMED_EMAIL=
PUBMED_API_KEY=

# Live disease & health intelligence (public-health surveillance feeds)
HEALTH_TIMEOUT=15
HEALTH_CACHE_TTL=900
HEALTH_MAX_ITEMS_PER_SOURCE=40
HEALTH_CURRENT_DAYS=14
HEALTH_RECENT_DAYS=60
HEALTH_USER_AGENT=RAGnosis-HealthIntelligence/1.0 (research; contact via repo)
# Override the built-in WHO/CDC/ECDC feeds. One "org|tier|scope|url" per line or
# separated by ';'. tier: primary_official|regional_official|secondary.
# scope: global|national|regional|local|unknown. Example (India-focused):
# HEALTH_SOURCE_FEEDS=WHO DON|primary_official|global|https://www.who.int/feeds/entity/csr/don/en/rss.xml
HEALTH_SOURCE_FEEDS=
